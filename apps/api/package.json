{
  "name": "@ghost/api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "PRISMA_CLIENT_ENGINE_TYPE=library tsx watch src/index.ts",
    "build": "tsc --build",
    "build:clean": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "start:dev": "PRISMA_CLIENT_ENGINE_TYPE=library NODE_ENV=development tsx src/index.ts",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint",
    "clean": "rm -rf dist node_modules",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "db:setup": "pnpm run prisma:generate && pnpm run prisma:migrate",
    "db:deploy": "pnpm run prisma:generate && pnpm run prisma:migrate:deploy"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@ghost/shared-types": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.87.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.0",
    "bs58": "^5.0.0",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "ethers": "^6.7.0",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "redis": "^4.6.0",
    "socket.io": "^4.6.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.5.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
