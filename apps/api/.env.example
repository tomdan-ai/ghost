# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis Configuration
REDIS_URL=redis://localhost:6379

# LI.FI API Configuration
LIFI_API_KEY=your-lifi-api-key

# JWT Configuration
JWT_SECRET=your-jwt-secret-must-be-at-least-32-characters-long

# Server Configuration
SOLANA_RPC_URL=http://localhost:8899
# For production: https://api.mainnet-beta.solana.com
# For devnet: https://api.devnet.solana.com
SOLANA_PAYER_PRIVATE_KEY=your_base58_private_key_here

PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_AUTH_ATTEMPTS=10

# Cache Configuration
CACHE_TTL_ROUTES_MS=300000
CACHE_TTL_USERNAME_MS=60000
CACHE_TTL_PROFILE_MS=600000
