// Prisma Schema for Ghost Wallet Backend
// Matches existing Supabase schema with proper indexes and constraints

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table - stores user information
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletAddress String    @unique @map("wallet_address")
  username      String    @unique
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  
  // Relations
  usernameRegistry UsernameRegistry?
  
  @@map("users")
  @@index([walletAddress], name: "idx_users_wallet")
  @@index([username], name: "idx_users_username")
}

// Username registry table - tracks username registrations
model UsernameRegistry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String   @unique
  walletAddress String   @unique @map("wallet_address")
  userId        String   @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("username_registry")
  @@index([username], name: "idx_username_registry_username")
}

// Payment requests table - stores payment initiation records
model PaymentRequest {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderWallet     String   @map("sender_wallet")
  receiverWallet   String   @map("receiver_wallet")
  amount           String   // Stored as string to preserve decimal precision
  sourceChain      String   @map("source_chain")
  destinationChain String   @map("destination_chain")
  status           String   // PENDING, PROCESSING, COMPLETED, FAILED
  txHash           String?  @map("tx_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  // Relations
  transactions Transaction[]
  
  @@map("payment_requests")
  @@index([senderWallet], name: "idx_payment_requests_sender")
  @@index([receiverWallet], name: "idx_payment_requests_receiver")
  @@index([status], name: "idx_payment_requests_status")
}

// Transactions table - stores transaction records for payment requests
model Transaction {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentRequestId  String   @map("payment_request_id") @db.Uuid
  sourceTx          String?  @map("source_tx")
  destinationTx     String?  @map("destination_tx")
  status            String   // PENDING, PROCESSING, COMPLETED, FAILED
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  // Relations
  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  
  @@map("transactions")
  @@index([paymentRequestId], name: "idx_transactions_payment_request")
}